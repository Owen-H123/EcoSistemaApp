<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eco_negro"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera negra: quiénes somos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/EtiquetaPanel"
                android:text="@string/empresa_nombre"
                android:textColor="@color/eco_lima" />

            <TextView
                style="@style/TextoTitulo.Claro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nosotros_titulo" />

            <TextView
                style="@style/TextoParrafo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/nosotros_intro"
                android:textColor="@color/eco_texto_claro" />
        </LinearLayout>

        <!-- Tarjeta blanca -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_superior"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/TituloSeccion"
                android:layout_marginTop="0dp"
                android:text="@string/nosotros_como_trabajamos" />

            <TextView
                style="@style/TextoParrafo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta_lima"
                android:padding="20dp"
                android:text="@string/nosotros_como_texto"
                android:textColor="@color/eco_texto" />

            <TextView style="@style/TituloSeccion" android:text="@string/nosotros_valores" />

            <LinearLayout
                android:id="@+id/ll_valores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView style="@style/TituloSeccion" android:text="@string/nosotros_fortalezas" />

            <LinearLayout
                android:id="@+id/ll_fortalezas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
