<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/tv_inicial"
        style="@style/Avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_actividad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_600"
            android:textColor="@color/eco_texto"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_detalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/eco_texto_suave"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_fecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_500"
            android:textColor="@color/eco_lima_oscuro"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_horas"
            style="@style/ValorTarjeta"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_monto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/eco_texto_suave"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
