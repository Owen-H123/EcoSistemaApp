<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_tarjeta_blanca"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_inicial"
        style="@style/Avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:textSize="18sp" />

    <!-- Con párrafo a 24sp el neto va debajo, no al costado -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_nombre"
            style="@style/TextoParrafo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_600"
            android:textColor="@color/eco_texto" />

        <TextView
            android:id="@+id/tv_cargo"
            style="@style/TextoParrafo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_detalle"
            style="@style/TextoParrafo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_500"
            android:textColor="@color/eco_lima_oscuro" />

        <TextView
            android:id="@+id/tv_neto"
            style="@style/ValorTarjeta"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
