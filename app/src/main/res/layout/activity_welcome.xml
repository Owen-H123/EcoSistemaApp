<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eco_fondo"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/logo_hannah" />

    <ImageView
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/empresa_nombre"
        android:src="@drawable/logo_hannah_texto" />


    <TextView
        style="@style/TextoMarca"
        android:textSize="40sp"
        android:layout_marginTop="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/marca"
        android:textColor="@color/eco_lima_oscuro" />

    <TextView
        style="@style/TextoParrafo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/empresa_lema" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_ingresar"
        style="@style/BotonPrimario"
        android:layout_marginTop="40dp"
        android:text="@string/welcome_ingresar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_iniciar_sesion"
        style="@style/BotonSecundario"
        android:layout_marginTop="12dp"
        android:text="@string/welcome_iniciar_sesion" />

    <TextView
        android:id="@+id/tv_olvide"
        style="@style/EnlaceEco"
        android:layout_marginTop="16dp"
        android:text="@string/welcome_olvide" />
</LinearLayout>
