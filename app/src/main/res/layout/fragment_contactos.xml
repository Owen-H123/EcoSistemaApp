<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eco_negro"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera negra -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/EtiquetaPanel"
                android:text="@string/empresa_nombre"
                android:textColor="@color/eco_lima" />

            <TextView
                style="@style/TextoTitulo.Claro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contactos_titulo" />

            <TextView
                style="@style/TextoParrafo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/contactos_intro"
                android:textColor="@color/eco_texto_claro" />
        </LinearLayout>

        <!-- Tarjeta blanca: datos + formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_superior"
            android:orientation="vertical"
            android:padding="24dp">

            <include android:id="@+id/dato_direccion" layout="@layout/item_dato_contacto" />

            <include android:id="@+id/dato_correo" layout="@layout/item_dato_contacto" />

            <include android:id="@+id/dato_web" layout="@layout/item_dato_contacto" />

            <TextView style="@style/TituloSeccion" android:text="@string/contacto_formulario" />

            <TextView style="@style/EtiquetaCampo" android:layout_marginTop="8dp" android:text="@string/contacto_nombre" />

            <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_nombre" style="@style/CampoEco">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:textColor="@color/eco_texto" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView style="@style/EtiquetaCampo" android:text="@string/login_correo" />

            <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_correo" style="@style/CampoEco">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_correo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/login_correo_hint"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/eco_texto" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView style="@style/EtiquetaCampo" android:text="@string/contacto_telefono" />

            <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_telefono" style="@style/CampoEco">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_telefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:textColor="@color/eco_texto" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView style="@style/EtiquetaCampo" android:text="@string/contacto_asunto" />

            <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_asunto" style="@style/CampoEco">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_asunto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:textColor="@color/eco_texto" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView style="@style/EtiquetaCampo" android:text="@string/contacto_mensaje" />

            <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_mensaje" style="@style/CampoEco">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_mensaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="4"
                    android:textColor="@color/eco_texto" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_enviar"
                style="@style/BotonPrimario"
                android:layout_width="match_parent"
                android:layout_marginTop="28dp"
                android:text="@string/contacto_enviar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_enviar_correo"
                style="@style/BotonSecundario"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/contacto_enviar_correo" />

            <TextView
                android:id="@+id/tv_registrados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/eco_texto_suave"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
