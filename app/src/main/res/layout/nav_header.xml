<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/eco_negro"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="40dp"
    android:paddingBottom="16dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/empresa_nombre"
        android:src="@drawable/logo_hannah_oscuro" />

    <TextView
        style="@style/TextoTitulo.Claro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/empresa_nombre" />

    <TextView
        style="@style/TextoParrafo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/empresa_lema"
        android:textColor="@color/eco_lima" />
</LinearLayout>
