<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eco_negro"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="40dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/marca"
                android:src="@drawable/logo_hannah_oscuro" />

            <TextView
                style="@style/TextoTitulo.Claro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/registro_titulo" />
        </LinearLayout>

        <!-- Tarjeta blanca: formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_superior"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="40dp"
            android:paddingEnd="32dp"
            android:paddingBottom="32dp">

            <TextView style="@style/EtiquetaCampo" android:layout_marginTop="0dp" android:text="@string/trabajador_nombre" />

            <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_nombre" style="@style/CampoEco">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:textColor="@color/eco_texto"
                    android:textSize="24sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView style="@style/EtiquetaCampo" android:text="@string/login_correo" />

            <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_correo" style="@style/CampoEco">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_correo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/login_correo_hint"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/eco_texto"
                    android:textSize="24sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView style="@style/EtiquetaCampo" android:text="@string/login_contrasena" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_contrasena"
                style="@style/CampoEco"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_contrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/eco_texto"
                    android:textSize="24sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView style="@style/EtiquetaCampo" android:text="@string/registro_repetir" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_repetir"
                style="@style/CampoEco"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_repetir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/eco_texto"
                    android:textSize="24sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_crear_cuenta"
                style="@style/BotonPrimario"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="40dp"
                android:text="@string/registro_boton" />

            <TextView
                android:id="@+id/tv_ya_tengo_cuenta"
                style="@style/EnlaceEco"
                android:layout_marginTop="12dp"
                android:text="@string/registro_ya_tengo" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
