<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_tarjeta_blanca"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/iv_icono"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circulo_lima"
        android:importantForAccessibility="no"
        android:padding="11dp"
        android:tint="@color/eco_lima_texto" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_label"
            style="@style/EtiquetaPanel"
            android:textColor="@color/eco_texto_suave" />

        <TextView
            android:id="@+id/tv_valor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_600"
            android:textColor="@color/eco_texto"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
